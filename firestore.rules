rules_version = '2';

// BonAcademy (Firebase-native) — Firestore Security Rules
// Roller: ADMIN, MANAGER (Müdür), INSTRUCTOR (Eğitmen), USER (Çalışan),
// CUSTOMER (dışarıdan eğitim alan müşteri — yalnızca kendi kaydına erişir).
// Rol, kullanıcının users/{uid} dokümanından okunur (Spark uyumlu — Cloud
// Functions/claim gerektirmez). Blaze'e geçince custom claim'e optimize edilebilir.
// Güvenlik-kritik yazımlar (sınav puanı, sertifika, atama durumu) client'a kapalı;
// yalnızca Cloud Functions (admin SDK) yazar.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function prof()      { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole()    { return prof().role; }
    function myDept()    { return prof().departmentId; }
    function isAdmin()      { return signedIn() && myRole() == 'ADMIN'; }
    // Departmansız müdür hiçbir departmanı görmez: null == null eşleşmesi
    // departmansız bütün kayıtları (müşteriler dahil) açıyordu.
    function isManager()    { return signedIn() && myRole() == 'MANAGER' && myDept() != null; }
    function isInstructor() { return signedIn() && myRole() == 'INSTRUCTOR'; }
    function isSelf(uid)    { return signedIn() && request.auth.uid == uid; }
    // CUSTOMER = dışarıdan eğitim alan müşteri. Personel değil: kurum yapısını
    // (departmanlar, yetki kapsamları, ayarlar) görmemeli.
    function isStaff()      { return signedIn() && myRole() != 'CUSTOMER'; }
    function courseData(cid){ return get(/databases/$(database)/documents/courses/$(cid)).data; }
    function ownsCourse(cid){ return isInstructor() && courseData(cid).ownerInstructorId == request.auth.uid; }
    // Çağıranın kendi kaydı. Aynı get() bir değerlendirme içinde tekrar
    // ederse Firestore onu tek okuma sayıyor.
    function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    /**
     * Bu kişi bu konuyu ÖĞRETEBİLİR mi? Eğitmen yetkisi users.instructorFor
     * listesinde; bitiş tarihi kişi başına tek (boşsa süresiz).
     * Kursu "sahiplenmek" ile aynı şey DEĞİL: içeriği bir kişi düzenler,
     * aynı konuyu birden fazla eğitmen verebilir.
     */
    function teachAuthorised(cid){
      return isInstructor()
        && cid in me().get('instructorFor', [])
        && (me().get('instructorAuthExpiry', null) == null
            || me().instructorAuthExpiry > request.time);
    }
    // Kursun İÇERİĞİNE erişim: kişiye atanmış ve erişimi engellenmemiş olmalı.
    // Atama id'si belirlenimci (`${userId}_${courseId}`); atama kaldırılınca
    // (cancelAssignment) belge silinir ve içerik kapanır, sertifika kalır.
    function hasCourseAccess(cid) {
      let a = /databases/$(database)/documents/assignments/$(request.auth.uid + '_' + cid);
      return signedIn() && exists(a) && get(a).data.get('accessBlocked', false) != true;
    }

    // ---- USERS ----
    match /users/{uid} {
      // Eğitmen, eğitim durumunu takip edebilmek için personeli okuyabilir.
      allow read: if isSelf(uid)
                  || isAdmin()
                  || isInstructor()
                  || (isManager() && resource.data.departmentId == myDept());
      // Kullanıcı kendi profilinde YALNIZCA dil ve telefonunu değiştirebilir.
      // Ad, doğum yeri/tarihi (sertifikaya basılır), "şifre değiştirmeli" ve
      // "profil tamamlandı" işaretleri SUNUCUDAN geçer (completeProfile,
      // changeTempPassword): eskiden kişi profileCompletedAt'i silip adını
      // istediği zaman değiştirebiliyor, mustChangePassword'ü kapatıp geçici
      // şifreyi kalıcı yapabiliyordu (güvenlik incelemesi, 08.10.2026).
      allow update: if isAdmin()
                    || (isSelf(uid)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['locale', 'phone', 'updatedAt'])
                        && request.resource.data.get('locale', 'tr') in ['tr', 'en', 'TR', 'EN']
                        && (request.resource.data.get('phone', null) == null
                            || (request.resource.data.phone is string
                                && request.resource.data.phone.size() < 40)));
      allow create, delete: if isAdmin();
    }

    // ---- Referans koleksiyonları ----
    match /departments/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /jobTitles/{id}   { allow read: if isStaff(); allow write: if isAdmin(); }
    match /appOptions/{id}  { allow read: if isStaff(); allow write: if isAdmin(); }
    match /orgSettings/{id} { allow read: if isStaff(); allow write: if isAdmin(); }

    // ---- COURSES (Eğitmen hazırlar; Admin her kursa) ----
    match /courses/{cid} {
      allow read: if signedIn(); // yalnızca meta (sorular ayrı alt-koleksiyonda)
      // Eğitmen kursu yayında olarak AÇAMAZ: yayın kontrolleri publishCourse'ta.
      allow create: if isAdmin()
                    || (isInstructor()
                        && request.resource.data.ownerInstructorId == request.auth.uid
                        && request.resource.data.get('isActive', false) == false
                        && !('publishedLangs' in request.resource.data));
      // isActive ve publishedLangs'e istemci DOKUNAMAZ — yayın kararı
      // publishCourse Function'ından geçer, çünkü içeriği olmayan bir dil
      // sürümü yayınlanmamalı (atanan kişi /learn'de hiç ilerleyemiyor).
      // Alanı hiç göndermemek geçerli: değişmemiş sayılır.
      allow update: if (isAdmin() || ownsCourse(cid))
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['isActive', 'publishedLangs']));
      allow delete: if isAdmin() || ownsCourse(cid);

      // Eğitim içeriği bölümleri (Bölüm 1, 2, ... — sıralı). Dosya adresleri
      // (PDF/video indirme URL'si, SCORM yolu) burada → yalnızca ADMIN,
      // EĞİTMEN ve eğitim kendisine atanmış (erişimi engellenmemiş) kişi
      // okur; müdür de yalnızca kendi atamasıyla. Kurs meta dokümanı listeler
      // (pano kartı, matris, sertifika) için açık kalıyor.
      // Yalnızca ADMIN veya sahibi EĞİTMEN düzenler.
      match /sections/{sid} {
        allow read: if isAdmin() || isInstructor() || hasCourseAccess(cid);
        allow write: if isAdmin() || ownsCourse(cid);
      }

      // ⚠️ Sorular: cevaplar (isCorrect) burada. Çalışan ERİŞEMEZ — sınav
      // sorularını cevapsız halde startExam Function'ından alır.
      match /questions/{qid} {
        allow read, write: if isAdmin() || ownsCourse(cid);
      }
      match /revisions/{r} {
        allow read: if isAdmin() || isInstructor();
        allow write: if false; // Function
      }
    }

    // ---- PLANS (atama planı — Admin/Müdür) ----
    // Kullanılmıyor (ekranı yok) — açık bırakılmasın.
    match /plans/{pid} {
      allow read, write: if false;
    }

    // ---- ASSIGNMENTS (atama döngüsü — durum geçişleri Function) ----
    match /assignments/{aid} {
      allow read: if isAdmin()
                  || isInstructor()
                  || isSelf(resource.data.userId)
                  || (isManager() && resource.data.userDepartmentId == myDept());
      allow write: if false; // yalnızca Function
      // SCORM ilerlemesi: yalnızca atamanın SAHİBİ yazar (eskiden herkes
      // başkasının atamasına kendi userId'siyle kayıt açabiliyordu).
      match /scorm/{rev} {
        allow read: if isAdmin() || isSelf(resource.data.userId);
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/assignments/$(aid)).data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && (resource == null || resource.data.userId == request.auth.uid);
      }
      match /examSessions/{n} { allow read, write: if false; }
      match /examAttempts/{n} {
        allow read: if isAdmin() || isSelf(resource.data.userId);
        allow write: if false;
      }
    }

    // ---- EXTERNAL TRAINING (dışarıdan alınan eğitim kayıtları) ----
    // Kurumun vermediği eğitimler. Sertifika ÜRETİLMEZ; personelin getirdiği
    // belge Storage'a iliştirilir. Admin herkese, müdür yalnızca kendi
    // departmanındaki personele kayıt girebilir.
    match /externalTrainings/{id} {
      function targetDept(uid) {
        return get(/databases/$(database)/documents/users/$(uid)).data.departmentId;
      }
      // Eğitmen de okur: Training Follow-Up ve kişi kaydı ona açık ve
      // eğitimlerin çoğu dış kayıtla kapanıyor. Okuyamadığında matris
      // sessizce "hepsi eksik" gösteriyordu.
      allow read: if isAdmin()
                  || isInstructor()
                  || isSelf(resource.data.userId)
                  || (isManager() && resource.data.userDepartmentId == myDept());
      // Belge adresi yalnızca Firebase Storage olabilir (javascript: gibi bir
      // adres, yönetici tıklayınca uygulamada kod çalıştırırdı).
      function fileUrlOk() {
        return request.resource.data.get('fileUrl', null) == null
          || (request.resource.data.fileUrl is string
              && request.resource.data.fileUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*'));
      }
      allow create: if fileUrlOk() && (isAdmin()
                    || (isManager()
                        && targetDept(request.resource.data.userId) == myDept()
                        && request.resource.data.userDepartmentId == myDept()));
      // Müdür kaydı başka departmana TAŞIYAMAZ (eskiden kendi departmanında
      // açıp sonra başkasının adına çevirebiliyordu).
      allow update: if fileUrlOk() && (isAdmin()
                    || (isManager()
                        && resource.data.userDepartmentId == myDept()
                        && request.resource.data.userDepartmentId == myDept()
                        && targetDept(request.resource.data.userId) == myDept()));
      allow delete: if isAdmin()
                    || (isManager() && resource.data.userDepartmentId == myDept());
    }

    // ---- CLASS SESSIONS (yüz yüze eğitim + QR yoklama) ----
    // Oturum id'si tahmin edilemez ve LİNKİN KENDİSİ paroladır: katılım formu
    // giriş istemez. Bu yüzden oturum dokümanı herkese okunur (yalnızca kurs
    // adı/tarih gibi görünür bilgi), yoklama kaydı ise ancak oturum AÇIKKEN
    // oluşturulabilir.
    match /classSessions/{sid} {
      function session() {
        return get(/databases/$(database)/documents/classSessions/$(sid)).data;
      }
      // Linki bilen TEK oturumu okur; oturumların LİSTESİ yalnızca personele
      // (eskiden girişsiz biri bütün oturum id'lerini — yani "parolaları" —
      // listeleyebiliyordu).
      allow get: if true;
      allow list: if isAdmin() || isInstructor();
      // Eğitmen yalnızca KENDİ oturumunu açar/değiştirir.
      // Kursa bağlı oturum için o konuda YETKİLİ olmak şart ("Other" serbest).
      // Eskiden şart kursun sahibi olmaktı; kursun tek sahibi var ama aynı
      // konuda birden çok eğitmen yetkili olabiliyor, o yüzden ölçü yetki.
      function ownCourseOrNone() {
        return request.resource.data.get('courseId', null) == null
          || request.resource.data.courseId == 'OTHER'
          || teachAuthorised(request.resource.data.courseId);
      }
      allow create: if isAdmin()
                    || (isInstructor()
                        && request.resource.data.createdById == request.auth.uid
                        && ownCourseOrNone());
      allow update: if isAdmin()
                    || (isInstructor()
                        && resource.data.createdById == request.auth.uid
                        && request.resource.data.createdById == request.auth.uid
                        && ownCourseOrNone());
      allow delete: if isAdmin()
                    || (isInstructor() && resource.data.createdById == request.auth.uid);

      match /attendees/{aid} {
        // Katılımcı kendi kaydını yazar; oturum kapandıysa yazamaz. YALNIZCA
        // formdaki alanlar: eskiden userId / email / rejected gibi alanlar da
        // yazılıp sertifikanın başkasına bağlanması sağlanabiliyordu.
        allow create: if session().status == 'OPEN'
                      && request.resource.data.keys().hasOnly(
                           ['fullName', 'firstName', 'lastName', 'birthPlace', 'birthDate', 'email', 'userId', 'signedAt'])
                      // Sertifika PDF'i bu adrese gider; eşleştirmede KULLANILMAZ.
                      && (request.resource.data.get('email', null) == null
                          || (request.resource.data.email is string
                              && request.resource.data.email.size() < 200
                              && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')))
                      && request.resource.data.get('userId', null) == null
                      && request.resource.data.signedAt == request.time
                      && request.resource.data.fullName is string
                      && request.resource.data.fullName.size() > 1
                      && request.resource.data.fullName.size() < 120
                      && request.resource.data.get('firstName', '') is string
                      && request.resource.data.get('firstName', '').size() < 60
                      && request.resource.data.get('lastName', '') is string
                      && request.resource.data.get('lastName', '').size() < 60
                      && (request.resource.data.get('birthPlace', null) == null
                          || (request.resource.data.birthPlace is string
                              && request.resource.data.birthPlace.size() < 80))
                      && (request.resource.data.get('birthDate', null) == null
                          || (request.resource.data.birthDate is string
                              && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
        // Katılımcı listesi (kişisel bilgiler) yalnızca oturumun sahibine ve admine.
        allow read, update, delete: if isAdmin()
                                    || (isInstructor() && session().createdById == request.auth.uid);
      }
    }

    // ---- CERTIFICATES ----
    match /certificates/{id} {
      // Kişi kendi belgesini yalnızca erişimi engellenmemişken görür
      // (setAssignmentAccess). Kendi sorgusu da where("blocked","==",false)
      // içermeli — kural süzgeç değil, sorgu bunu garanti etmeli.
      allow read: if isAdmin()
                  || isInstructor()
                  || (isSelf(resource.data.userId) && resource.data.blocked == false)
                  || (isManager() && resource.data.userDepartmentId == myDept());
      allow write: if false; // yalnızca issueCertificate Function
    }
    // Doğrulama kaydı tahmin edilemez bir anahtarla adreslenir; anahtar
    // yalnızca belgedeki QR kodunda. Numarayla adreslenseydi (26-001,
    // 26-002…) sırayla girilip bütün personelin adı dökülebilirdi.
    // Tek tek okunur (QR'daki anahtarla); LİSTELENEMEZ — eskiden bütün
    // sertifika sahiplerinin adı tek sorguyla indirilebiliyordu.
    match /certVerify/{verifyToken} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // ---- Function-managed / salt-okunur ----
    match /notifications/{id} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      allow write: if false;
    }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    // Sertifika numarası sayacı. Numarayı FUNCTION artırır (transaction);
    // admin yalnızca BİÇİMİ ayarlayabilir — kâğıt sicilden devam edebilmek
    // için sıradaki numarayı elle vermek gerekiyor.
    // Sertifika numarası sayacı. Numarayı YALNIZCA Function verir (transaction);
    // ön ek yıldır ve seri her yıl başında kendiliğinden sıfırlanır. Elle
    // düzenleme kaldırıldı: yanlış bir ön ek ya da geri alınan bir numara
    // sicili sessizce bozar ve verilmiş bir numara geri alınamaz.
    match /counters/{id} {
      allow read: if isAdmin() || isInstructor();
      allow write: if false;
    }


    // ── SSO biletleri ───────────────────────────────────────
    // Tek şifre devrinde kullanılan tek kullanımlık biletler. YALNIZ
    // Cloud Functions (Admin SDK, kuralları baypas eder) yazar ve okur.
    // Aşağıdaki genel reddin kapsamında zaten kapalı; burada açıkça
    // yazılıyor ki koleksiyonu arayan biri nerede yönetildiğini görsün.
    match /sso_tickets/{ticketHash} {
      allow read, write: if false;
    }
    // ── Atama silme kaydı ───────────────────────────────────
    // Silinen atamanın izi: kim, ne zaman, neden kaldırdı. Yalnızca Function
    // (Admin SDK) yazar; admin okuyabilsin diye okuma açık.
    match /assignmentRemovals/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
