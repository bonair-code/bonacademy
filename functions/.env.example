# functions/.env icin ornek. Gercek dosya git'e girmez.
# Gizli deger YOK: SMTP sifresi Secret Manager'da tutulur.
#   npx firebase functions:secrets:set SMTP_PASSWORD --project bonair-academy

# E-posta anahtari. Varsayilan kapali; "true" olmadan hicbir e-posta cikmaz.
# Kapaliyken SMTP_PASSWORD sirri hicbir fonksiyona baglanmaz, yani sir
# tanimli olmadan da deploy edilebilir (bkz. functions/src/mail.ts).
MAIL_ENABLED=false

# Posta acilacagi zaman doldurulur:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
MAIL_FROM=noreply@bonair.com.tr
APP_URL=https://academy.bonair.com.tr
