rules_version = '2';

// BonAcademy — Cloud Storage kuralları
// Kurs içeriği (content/, scorm/) yalnızca ADMIN, EĞİTMEN ve eğitim kendisine
// atanmış kişiye açık. Yükleme yalnızca içeriği hazırlayan roller.
// Sertifika PDF'leri kişiseldir → sahibi + staff okur.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn()  { return request.auth != null; }
    // Kişinin bütün rolleri. Eski jetonda 'roles' yok; tek 'role'a düşer.
    function myRoles()   { return request.auth.token.get('roles', [request.auth.token.get('role', 'USER')]); }
    function isAdmin()   { return signedIn() && 'ADMIN' in myRoles(); }
    function isManager() { return signedIn() && 'MANAGER' in myRoles(); }
    function isInstructor() { return signedIn() && 'INSTRUCTOR' in myRoles(); }

    // Kurs içeriği için rol ve atama Firestore'dan okunur (cross-service).
    // Claim'e güvenilmiyor: claim'i olmayan eski hesaplar da var.
    function isContentStaff() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
             .data.get('roles', [firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role])
             .hasAny(['ADMIN', 'INSTRUCTOR']);
    }
    /** Firestore'daki rol listesi; 'roles' yoksa tek 'role'a düşer. */
    function fsRoles() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
        .data.get('roles', [firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role]);
    }
    // Kursu yükleyebilen: admin ya da kursun sahibi eğitmen (eskiden HER eğitmen
    // HER kursun içeriğine dosya yazabiliyordu).
    function canEditCourse(courseId) {
      return signedIn()
        && ('ADMIN' in fsRoles()
            || ('INSTRUCTOR' in fsRoles()
                && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.get('ownerInstructorId', null)
                     == request.auth.uid));
    }
    // Kişiye atanmış ve erişimi engellenmemiş eğitim (atama id'si `${uid}_${courseId}`).
    function hasCourseAccess(courseId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/assignments/$(request.auth.uid + '_' + courseId))
        && firestore.get(/databases/(default)/documents/assignments/$(request.auth.uid + '_' + courseId))
             .data.get('accessBlocked', false) != true;
    }

    // Kurs kapak görseli: covers/{courseId}/...
    // Kapak kurs kataloğunun bir parçası — eğitimi atanan herkes (müşteri dahil)
    // görür. Yükleme yalnızca eğitimi hazırlayan roller.
    match /covers/{courseId}/{allPaths=**} {
      allow read: if signedIn();
      allow create: if canEditCourse(courseId)
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow update, delete: if signedIn() && 'ADMIN' in fsRoles();
    }

    // SCORM paket içeriği: scorm/{courseId}/{revision}/...
    // Eski yol — artık hiçbir yer yazmıyor (SCORM content/ altında).
    match /scorm/{courseId}/{allPaths=**} {
      allow read: if isContentStaff() || hasCourseAccess(courseId);
      allow write: if false;
    }

    // Bölüm içerikleri (PDF / video / SCORM dosyaları): content/{courseId}/{sectionId}/...
    // Okuma: ADMIN, EĞİTMEN ve eğitim kendisine atanmış kişi. Yükleme yalnızca
    // içeriği hazırlayan roller (CourseDetail).
    // NOT: getDownloadURL'nin jetonlu adresleri kuralları atlar; o adresler
    // sections dokümanında durduğu için Firestore kuralıyla korunuyor.
    // Yükleme: admin ya da kursun sahibi eğitmen; üzerine yazma/silme yalnız
    // admin (istemci her yüklemede yeni bir yol kullanıyor). Video için 2 GB üst sınır.
    match /content/{courseId}/{allPaths=**} {
      allow read: if isContentStaff() || hasCourseAccess(courseId);
      allow create: if canEditCourse(courseId)
                    && request.resource.size < 2 * 1024 * 1024 * 1024;
      allow update, delete: if signedIn() && 'ADMIN' in fsRoles();
    }

    // Dışarıdan alınan eğitim belgeleri: externalCertificates/{userId}/...
    // Rol ve departman custom claim'den okunur (Storage kuralları Firestore'a
    // bakamaz) — createUser/updateUser bu claim'leri yazıyor.
    // Müdür yalnızca KENDİ departmanındaki kişinin belgesine erişir (eskiden
    // herkesinkini okuyup silebiliyordu). Yalnızca PDF/görsel, 20 MB.
    match /externalCertificates/{userId}/{allPaths=**} {
      function sameDept() {
        return request.auth.token.departmentId != null
          && firestore.get(/databases/(default)/documents/users/$(userId)).data.departmentId
               == request.auth.token.departmentId;
      }
      allow read: if isAdmin()
                  || (signedIn() && request.auth.uid == userId)
                  || (isManager() && sameDept());
      allow create: if (isAdmin() || (isManager() && sameDept()))
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType.matches('application/pdf|image/(png|jpeg|webp)');
      allow update, delete: if isAdmin();
    }

    // Sertifika PDF'leri: certificates/{userId}/{certId}.pdf
    match /certificates/{userId}/{file} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if false; // yalnızca issueCertificate Function (admin SDK)
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
